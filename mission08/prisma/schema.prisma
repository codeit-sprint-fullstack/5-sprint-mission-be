// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id        String           @id @default(uuid())
  title     String
  content   String
  author    String           @default("민지영")
  likes     Int              @default(0)
  comments  ArticleComment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([createdAt, updatedAt]) // updatedAt에 인덱스 추가
}

model ArticleComment {
  id        String   @id @default(uuid())
  content   String
  author    String   @default("민지영")
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade) // onDelete: Cascade -> post가 삭제되면 comment도 삭제
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 인덱스 추가: articleId, createdAt 필드에 인덱스를 추가
  @@index([articleId]) // articleId에 인덱스 추가
  @@index([createdAt, updatedAt]) // createdAt에 인덱스 추가
}
